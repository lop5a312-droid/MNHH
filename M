<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop Roblox Level 4</title>
  <style>
    body {margin:0;font-family:'Segoe UI';background:linear-gradient(135deg,#020617,#0f172a);color:white}
    header {padding:20px;text-align:center;font-size:26px;background:rgba(0,0,0,0.6)}
    .auth{text-align:center;margin:10px}
    input{padding:10px;margin:5px;border-radius:8px;border:none}
    .container{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;padding:20px}
    .card{background:#1e293b;padding:15px;border-radius:12px}
    button{width:100%;padding:10px;background:#22c55e;border:none;border-radius:8px;cursor:pointer;margin-top:10px}
    .hidden{display:none}
    .modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);justify-content:center;align-items:center}
    .modal-box{background:#1e293b;padding:20px;border-radius:10px;text-align:center}
    .admin{background:#111;padding:10px;margin:10px;border-radius:10px}
  </style>
</head>
<body>

<header>🔥 SHOP ROBLOX LEVEL 4 🔥</header>

<div class="auth" id="authBox">
  <input type="text" id="user" placeholder="Tài khoản">
  <input type="password" id="pass" placeholder="Mật khẩu">
  <br>
  <button onclick="register()">Đăng ký</button>
  <button onclick="login()">Đăng nhập</button>
</div>

<div class="admin hidden" id="adminPanel">
  <h3>➕ Thêm Acc</h3>
  <input id="accName" placeholder="Tên acc">
  <input id="accPrice" placeholder="Giá">
  <input id="accData" placeholder="user|pass">
  <button onclick="addAcc()">Thêm</button>
</div>

<div class="container hidden" id="shop"></div>

<div class="modal" id="modal">
  <div class="modal-box">
    <h2 id="product"></h2>
    <p>Chuyển khoản Momo: 0123456789</p>
    <p>Nội dung: Tên tài khoản + sản phẩm</p>
    <button onclick="confirmPay()">Tôi đã thanh toán</button>
  </div>
</div>

<script>
let currentUser = null;

let accounts = JSON.parse(localStorage.getItem('accounts')) || [
  {name:'Acc VIP', price:'199.000đ', data:'vipuser|123456'},
  {name:'Acc Pro', price:'299.000đ', data:'prouser|654321'}
];

function save(){
  localStorage.setItem('accounts', JSON.stringify(accounts));
}

function renderShop(){
  let html = '';
  accounts.forEach((acc,i)=>{
    html += `
    <div class="card">
      <h3>${acc.name}</h3>
      <p>${acc.price}</p>
      <button onclick="buy(${i})">Mua</button>
    </div>`;
  });
  shop.innerHTML = html;
}

function register(){
  localStorage.setItem(user.value, pass.value);
  alert('Đăng ký xong');
}

function login(){
  if(localStorage.getItem(user.value)===pass.value){
    currentUser=user.value;
    authBox.classList.add('hidden');
    shop.classList.remove('hidden');
    renderShop();

    if(currentUser==='admin'){
      adminPanel.classList.remove('hidden');
    }
  }else alert('Sai');
}

function addAcc(){
  accounts.push({
    name:accName.value,
    price:accPrice.value,
    data:accData.value
  });
  save();
  renderShop();
  alert('Đã thêm acc');
}

let selectedIndex=null;

function buy(i){
  selectedIndex=i;
  modal.style.display='flex';
  product.innerText=accounts[i].name;
}

function confirmPay(){
  let acc = accounts[selectedIndex];
  alert('Acc: '+acc.data);

  accounts.splice(selectedIndex,1);
  save();
  renderShop();
  modal.style.display='none';
}
</script>

</body>
</html>
